{
  "file": "Dockerfile_test_issue_1743",
  "build_args": {},
  "ok": true,
  "env": [
    "PATH=/usr/local/bin:/usr/bin:/bin",
    "BASE_VAR=from-base"
  ],
  "labels": {
    "base.label": "base"
  },
  "user": "",
  "volumes": [],
  "stop_signal": "",
  "runs": [
    {
      "args": [
        "/bin/sh",
        "-c",
        "grep -q 'content' /work/symlink.txt"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "grep -q 'shared' /sep1/target.txt"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "grep -q 'shared' /sep2/hardlink.txt"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "mkdir /sep1 /sep2     && echo \"shared\" > /sep1/target.txt     && ln /sep1/target.txt /sep2/hardlink.txt"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "mkdir /work     && echo \"content\" > /work/target.txt     && ln -s target.txt /work/symlink.txt     && ln /work/target.txt /work/hardlink.txt     && mkfifo /work/pipe"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "readlink /work/symlink.txt | grep -q '^target\\.txt$'"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "test -L /work/symlink.txt"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "test -p /work/pipe"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "test \"$(stat -c %h /work/hardlink.txt)\" = \"2\""
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "test \"$(stat -c %i /work/hardlink.txt)\" = \"$(stat -c %i /work/target.txt)\""
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    }
  ]
}
