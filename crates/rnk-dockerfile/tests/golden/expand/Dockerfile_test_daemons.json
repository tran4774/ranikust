{
  "file": "Dockerfile_test_daemons",
  "build_args": {},
  "ok": true,
  "env": [
    "PATH=/usr/local/bin:/usr/bin:/bin",
    "BASE_VAR=from-base"
  ],
  "labels": {
    "base.label": "base"
  },
  "user": "",
  "volumes": [],
  "stop_signal": "",
  "runs": [
    {
      "args": [
        "/bin/sh",
        "-c",
        "(while true; do sleep 10; dd if=/dev/zero of=file`date +%s`.txt count=16000 bs=256  > /dev/null 2>&1; done &); sleep 1"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "echo \"wait a second...\" && sleep 2 && ls -lrat file*.txt || echo \"test passed.\""
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    }
  ]
}
