{
  "file": "Dockerfile_test_volume",
  "build_args": {},
  "ok": true,
  "env": [
    "PATH=/usr/local/bin:/usr/bin:/bin",
    "BASE_VAR=from-base",
    "VOL=/baz/bat"
  ],
  "labels": {
    "base.label": "base"
  },
  "user": "",
  "volumes": [
    "/baz/bat",
    "/foo/bar",
    "/qux/quux",
    "/tmp"
  ],
  "stop_signal": "",
  "runs": [
    {
      "args": [
        "/bin/sh",
        "-c",
        "echo \"hello again\" > /tmp/hey"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin",
        "VOL=/baz/bat"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "echo \"hello\" > /foo/hey"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "mkdir /foo"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    }
  ]
}
