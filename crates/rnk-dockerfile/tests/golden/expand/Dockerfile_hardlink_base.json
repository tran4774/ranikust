{
  "file": "Dockerfile_hardlink_base",
  "build_args": {},
  "ok": true,
  "env": [
    "PATH=/usr/local/bin:/usr/bin:/bin",
    "BASE_VAR=from-base"
  ],
  "labels": {
    "base.label": "base"
  },
  "user": "",
  "volumes": [],
  "stop_signal": "",
  "runs": [
    {
      "args": [
        "/bin/sh",
        "-c",
        "apk --no-cache add git"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "rm /usr/bin/git && ln -s /usr/libexec/git-core/git /usr/bin/git"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    }
  ]
}
