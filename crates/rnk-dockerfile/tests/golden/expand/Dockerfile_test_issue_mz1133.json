{
  "file": "Dockerfile_test_issue_mz1133",
  "build_args": {},
  "ok": true,
  "env": [
    "PATH=/usr/local/bin:/usr/bin:/bin",
    "BASE_VAR=from-base"
  ],
  "labels": {
    "base.label": "base"
  },
  "user": "app",
  "volumes": [],
  "stop_signal": "",
  "runs": [
    {
      "args": [
        "/bin/sh",
        "-c",
        "adduser -D -u 1234 app"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "echo base > /keep/base && printf target > /target && ln -s /target /aslink && printf old > /old"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "mkdir -p /out && printf built > /out/file"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "mkdir -p /real /keep /xreal && ln -s /real /link && ln -s /xreal /xlink"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "mkdir -p /treal /ureal /xureal /preal && ln -s /treal /tlink && ln -s /ureal /ulink && ln -s /xureal /xulink && ln -s /preal /plink"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "test ! -L /aslink && test \"$(cat /target)\" = target"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "test ! -L /link && test -f /link/foo && test ! -e /real/foo"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "test ! -L /tlink && test ! -L /ulink && test ! -L /xulink && test ! -L /plink && test -z \"$(find /treal /ureal /xureal /preal -mindepth 1)\""
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "test ! -L /xlink && test \"$(cat /xlink/file)\" = built && test ! -e /xreal/file"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "test -f /keep/base && test -f /keep/foo"
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    },
    {
      "args": [
        "/bin/sh",
        "-c",
        "test \"$(cat /old)\" = \"$(cat /keep/foo)\""
      ],
      "env": [
        "BASE_VAR=from-base",
        "PATH=/usr/local/bin:/usr/bin:/bin"
      ]
    }
  ]
