#cloud-config
# Provisions the T2 VM's base image for RANIKUST_VM_RELEASE=alma9 (AlmaLinux
# 9, ADR-0100 row 9e), as cloud-init/provision does for Ubuntu: tests/vm/vm.sh
# boots the verified cloud image once with this seed, waits for the VM to
# power itself off, and keeps the result as the read-only backing file of
# every run's throwaway disk. vm.sh puts the package list in place of
# @PACKAGES@. SELinux stays enforcing: the image is only checked for it.
#
# Nothing to log in with is left in it: no user, no key, no password; the
# SSH host keys and the machine ID are removed, so that each run's first
# boot (a new instance ID) makes its own, and each run's seed adds user
# `rnk` with that run's key.
users: []
ssh_pwauth: false
disable_root: true

@PACKAGES@

runcmd:
  # SELinux's denials reach the audit log through it (guest/el9.sh).
  - [systemctl, enable, auditd]
  # Background dnf runs compete with the suites for CPU and disk: none in
  # the base image.
  - [systemctl, disable, --now, dnf-makecache.timer]
  - [dnf, clean, all]
  - [sh, -c, 'rm -f /etc/ssh/ssh_host_*']
  - [sh, -c, 'truncate -s 0 /etc/machine-id && rm -f /var/lib/dbus/machine-id']
  # The disk has discard: freed blocks go, and the flattened image is
  # smaller.
  - [fstrim, --all]
  # Read by vm.sh from the serial log: the image is complete.
  - [sh, -c, 'command -v podman && command -v docker && command -v newuidmap && command -v ausearch && systemctl is-enabled auditd && test "$(getenforce)" = Enforcing && echo ranikust-golden-ready >/dev/ttyS0']

power_state:
  mode: poweroff
  timeout: 120
  condition: true
