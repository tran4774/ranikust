#cloud-config
# NoCloud seed of each T2 VM run; tests/vm/vm.sh puts the run's own key in
# place of @SSH_KEY@, the Docker Hub mirror (RANIKUST_VM_IMAGE_REGISTRY) in
# place of @REGISTRY_MIRRORS@, so the guest's Docker avoids Docker Hub's pull
# limit, and in place of @PACKAGES@ nothing when the run boots the
# provisioned base image (cloud-init/provision, the default), or the package
# list when it boots the plain cloud image (RANIKUST_VM_GOLDEN=0).
hostname: ranikust-vm
ssh_pwauth: false

users:
  - name: rnk
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - @SSH_KEY@

@PACKAGES@

write_files:
  - path: /etc/docker/daemon.json
    content: |
      {"registry-mirrors": @REGISTRY_MIRRORS@}

runcmd:
  - [systemctl, enable, docker]
  - [systemctl, restart, docker]
  - [usermod, -aG, docker, rnk]
  - [touch, /var/lib/ranikust-vm-ready]
