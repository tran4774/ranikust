{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL": "1h"
  },
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo doc *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo deny check *)",
      "Bash(cargo deny --locked check *)",
      "Bash(just)",
      "Bash(just --list)",
      "Bash(just check)",
      "Bash(just fmt)",
      "Bash(just fmt-check)",
      "Bash(just lint)",
      "Bash(just test *)",
      "Bash(just build-static)",
      "Bash(just check-aarch64)",
      "Bash(just deny)",
      "Bash(just doc)",
      "Bash(just book)",
      "Bash(just changelog)",
      "Bash(just ci)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(rg *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin *)",
      "Bash(git pull --ff-only)",
      "Bash(git pull --ff-only origin)",
      "Bash(git pull --ff-only origin *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(just docs-lint)",
      "Bash(gh issue view *)",
      "Bash(gh issue list)",
      "Bash(gh issue list *)",
      "Bash(gh pr view)",
      "Bash(gh pr view *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(gh project view *)",
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(gh label list)",
      "Bash(gh label list *)",
      "Bash(gh release list)",
      "Bash(gh release list *)",
      "Bash(gh release view)",
      "Bash(gh release view *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(pkexec *)",
      "Bash(su *)",
      "Bash(doas *)",
      "Bash(mount *)",
      "Bash(umount *)",
      "Bash(unshare *)",
      "Bash(nsenter *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -fr /)",
      "Bash(rm -fr / *)",
      "Bash(rm *--no-preserve-root*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(rg *--pre*)",
      "Bash(rg *.ssh*)",
      "Bash(rg *.docker/config.json*)",
      "Bash(rg *containers/auth.json*)",
      "Bash(rg *.config/gh*)",
      "Bash(rg *oauth_token*)",
      "Bash(cargo publish *)",
      "Bash(cargo *--config*)",
      "Bash(cargo *--manifest-path*)",
      "Bash(cargo *-Z*)",
      "Bash(cargo *--logfile*)",
      "Bash(just test *--config*)",
      "Bash(just test *--manifest-path*)",
      "Bash(just test *-Z*)",
      "Bash(just test *--logfile*)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git pull *--upload-pack*)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(git stash *--output*)",
      "Bash(git diff *--no-index*)",
      "Bash(git diff *--ext-diff*)",
      "Bash(git log *--ext-diff*)",
      "Bash(git show *--ext-diff*)",
      "Bash(git stash *--ext-diff*)",
      "Bash(git commit *-F /*)",
      "Bash(git commit *-F/*)",
      "Bash(git commit *-F ~*)",
      "Bash(git commit *-F $*)",
      "Bash(git commit *-F ..*)",
      "Bash(git commit *--file=*)",
      "Bash(git commit *--file /*)",
      "Bash(git commit *--file ~*)",
      "Bash(git commit *--file $*)",
      "Bash(git commit *--file ..*)",
      "Bash(git commit *--template*)",
      "Bash(git commit *-t /*)",
      "Bash(git commit *-t ~*)",
      "Bash(git commit *-t $*)",
      "Bash(git commit *-t ..*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * v*)",
      "Bash(git push --tags*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force-with-lease*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh release edit*)",
      "Bash(gh release upload*)",
      "Bash(gh issue delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive)",
      "Bash(gh repo archive *)",
      "Bash(gh repo deploy-key *)",
      "Bash(gh auth token*)",
      "Bash(gh auth git-credential *)",
      "Bash(git credential *)",
      "Bash(gh config get *oauth_token*)",
      "Bash(gh auth status *--show-token*)",
      "Bash(gh auth status -t*)",
      "Bash(gh auth status *-t)",
      "Bash(gh auth status *-t *)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *-X=DELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(gh api *-X delete*)",
      "Bash(gh api *-Xdelete*)",
      "Bash(gh api *--method delete*)",
      "Bash(gh api *--method=delete*)",
      "Bash(gh api *graphql*delete*)",
      "Bash(gh api *refs/tags*)",
      "Bash(gh api *releases*-X*)",
      "Bash(gh api *-X*releases*)",
      "Bash(gh api *releases*--method*)",
      "Bash(gh api *--method*releases*)",
      "Bash(gh api *releases*-f*)",
      "Bash(gh api *-f*releases*)",
      "Bash(gh api *releases*-F*)",
      "Bash(gh api *-F*releases*)",
      "Bash(gh api *releases*--field*)",
      "Bash(gh api *--field*releases*)",
      "Bash(gh api *releases*--raw-field*)",
      "Bash(gh api *--raw-field*releases*)",
      "Bash(gh api *releases*--input*)",
      "Bash(gh api *--input*releases*)",
      "Bash(gh api *-X=delete*)",
      "Bash(gh api *delete*graphql*)",
      "Bash(gh api *refs/heads*-X*)",
      "Bash(gh api *-X*refs/heads*)",
      "Bash(gh api *refs/heads*--method*)",
      "Bash(gh api *--method*refs/heads*)",
      "Bash(gh api *refs/heads*-f*)",
      "Bash(gh api *-f*refs/heads*)",
      "Bash(gh api *refs/heads*-F*)",
      "Bash(gh api *-F*refs/heads*)",
      "Bash(gh api *refs/heads*--input*)",
      "Bash(gh api *--input*refs/heads*)",
      "Bash(gh api *graphql*updateRef*)",
      "Bash(gh api *updateRef*graphql*)",
      "Bash(gh api *graphql*createRef*)",
      "Bash(gh api *createRef*graphql*)",
      "Bash(tests/vm/runner.sh*)",
      "Bash(./tests/vm/runner.sh*)",
      "Bash(bash *tests/vm/runner.sh*)",
      "Bash(sh *tests/vm/runner.sh*)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/containers/auth.json)",
      "Read(//run/user/*/containers/auth.json)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/rustfmt-edited.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
