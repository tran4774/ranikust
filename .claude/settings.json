{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo doc *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo deny check *)",
      "Bash(cargo deny --locked check *)",
      "Bash(just)",
      "Bash(just --list)",
      "Bash(just check)",
      "Bash(just fmt)",
      "Bash(just fmt-check)",
      "Bash(just lint)",
      "Bash(just test *)",
      "Bash(just build-static)",
      "Bash(just check-aarch64)",
      "Bash(just deny)",
      "Bash(just doc)",
      "Bash(just book)",
      "Bash(just changelog)",
      "Bash(just ci)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(rg *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin *)",
      "Bash(git pull --ff-only)",
      "Bash(git pull --ff-only origin)",
      "Bash(git pull --ff-only origin *)",
      "Bash(git branch *)",
      "Bash(git stash *)"
    ],
    "ask": [],
    "deny": [
      "Bash(sudo *)",
      "Bash(pkexec *)",
      "Bash(su *)",
      "Bash(doas *)",
      "Bash(mount *)",
      "Bash(umount *)",
      "Bash(unshare *)",
      "Bash(nsenter *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -fr /)",
      "Bash(rm -fr / *)",
      "Bash(rm *--no-preserve-root*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(rg *--pre*)",
      "Bash(rg *.ssh*)",
      "Bash(rg *.docker/config.json*)",
      "Bash(rg *containers/auth.json*)",
      "Bash(cargo publish *)",
      "Bash(cargo *--config*)",
      "Bash(cargo *--manifest-path*)",
      "Bash(cargo *-Z*)",
      "Bash(cargo *--logfile*)",
      "Bash(just test *--config*)",
      "Bash(just test *--manifest-path*)",
      "Bash(just test *-Z*)",
      "Bash(just test *--logfile*)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git pull *--upload-pack*)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(git stash *--output*)",
      "Bash(git diff *--no-index*)",
      "Bash(git diff *--ext-diff*)",
      "Bash(git log *--ext-diff*)",
      "Bash(git show *--ext-diff*)",
      "Bash(git stash *--ext-diff*)",
      "Bash(git commit *-F /*)",
      "Bash(git commit *-F/*)",
      "Bash(git commit *-F ~*)",
      "Bash(git commit *-F $*)",
      "Bash(git commit *-F ..*)",
      "Bash(git commit *--file=*)",
      "Bash(git commit *--file /*)",
      "Bash(git commit *--file ~*)",
      "Bash(git commit *--file $*)",
      "Bash(git commit *--file ..*)",
      "Bash(git commit *--template*)",
      "Bash(git commit *-t /*)",
      "Bash(git commit *-t ~*)",
      "Bash(git commit *-t $*)",
      "Bash(git commit *-t ..*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/containers/auth.json)",
      "Read(//run/user/*/containers/auth.json)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/rustfmt-edited.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
